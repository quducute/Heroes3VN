{
  "name": "heroes3vn",
  "productName": "Heroes 3 VN by Gogetto",
  "version": "2026.11.13",
  "description": "Tool lưu trữ link tải/mua Heroes 3 mọi phiên bản",
  "author": "Gogetto",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "preview": "vite build && electron .",
    "build": "vite build && electron-builder --win && node scripts/renameArtifact.cjs",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@fontsource/luxurious-roman": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "vn.gogetto.heroes3",
    "productName": "Heroes 3 VN by Gogetto",
    "compression": "maximum",
    "afterPack": "./scripts/afterPack.cjs",
    "files": [
      "dist/**",
      "electron/**",
      "!dist/assets/*.woff",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Heroes3VN-Windows-v${version}.exe"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
