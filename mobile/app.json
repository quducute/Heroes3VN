{
  "expo": {
    "name": "Heroes 3 VN by Gogetto",
    "slug": "heroes3vn",
    "version": "2026.11.01",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "heroes3vn",
    "icon": "./assets/icon.png",
    "android": {
      "package": "vn.gogetto.heroes3",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "vn.gogetto.heroes3",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ]
  }
}
