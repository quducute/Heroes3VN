{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Heroes 3 VN by Gogetto",
  "mainBinaryName": "heroes3vn",
  "version": "2026.11.8",
  "identifier": "vn.gogetto.heroes3.webview2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build && node scripts/pruneDist.js"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
